<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the client core from its Unity package under Unity's constraints: .NET Standard 2.1,
    C# 9 and no engine references.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.halcyonic.client/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Halcyonic.Contracts/Halcyonic.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
  </ItemGroup>
</Project>
