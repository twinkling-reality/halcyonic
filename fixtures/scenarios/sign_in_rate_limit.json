{
  "format": 1,
  "id": "sign_in_rate_limit",
  "description": "Limits failed sign-in attempts in a new table. Asks before running the migration; the tests then show one gap, which a later instruction closes. The recorded demonstration's main story.",
  "steps": [
    {
      "after_ms": 500,
      "emit": {
        "type": "runtime.agent_message",
        "payload": {
          "text": "I will count failed sign-in attempts in a new table and answer 429 after five failures within fifteen minutes."
        }
      }
    },
    {
      "after_ms": 400,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-1",
          "tool_name": "read",
          "title": "src/routes/sign-in.ts"
        }
      }
    },
    {
      "after_ms": 500,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-1", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 0,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-2",
          "tool_name": "edit",
          "title": "src/middleware/rate-limit.ts"
        }
      }
    },
    {
      "after_ms": 1100,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-2", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 0,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-3",
          "tool_name": "edit",
          "title": "migrations/0012_sign_in_attempts.sql"
        }
      }
    },
    {
      "after_ms": 700,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-3", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 0,
      "await_approval": {
        "approval_id": "approval-1",
        "subject": {
          "kind": "tool_use",
          "tool_name": "shell",
          "summary": "Run make migrate to add the sign-in attempts table to the development database"
        },
        "if_approved": [
          {
            "after_ms": 0,
            "emit": {
              "type": "runtime.tool.started",
              "payload": { "tool_call_id": "call-4", "tool_name": "shell", "title": "make migrate" }
            }
          },
          {
            "after_ms": 1200,
            "emit": {
              "type": "runtime.tool.completed",
              "payload": { "tool_call_id": "call-4", "outcome": "succeeded" }
            }
          },
          {
            "after_ms": 0,
            "emit": {
              "type": "runtime.test_run.started",
              "payload": { "test_run_id": "tests-1", "label": "make test SUITE=sign-in" }
            }
          },
          {
            "after_ms": 2200,
            "emit": {
              "type": "runtime.test_run.completed",
              "payload": {
                "test_run_id": "tests-1",
                "outcome": "failed",
                "summary": "1 failed, 23 passed"
              }
            }
          },
          {
            "after_ms": 0,
            "emit": {
              "type": "runtime.agent_message",
              "payload": {
                "text": "The migration ran and the limit works per address. One test fails: it expects failures from different addresses to lock the same account."
              }
            }
          },
          { "after_ms": 0, "emit": { "type": "runtime.turn.completed", "payload": {} } }
        ],
        "if_denied": [
          {
            "after_ms": 400,
            "emit": {
              "type": "runtime.agent_message",
              "payload": {
                "text": "Understood, I did not run the migration. The limiter has no table to keep attempts in until it runs."
              }
            }
          },
          { "after_ms": 0, "emit": { "type": "runtime.turn.completed", "payload": {} } }
        ]
      }
    }
  ],
  "instructions": [
    {
      "text": "Count failed attempts per account as well as per address.",
      "steps": [
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.agent_message",
            "payload": { "text": "I will count failures per account too, in the same table." }
          }
        },
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.tool.started",
            "payload": {
              "tool_call_id": "call-5",
              "tool_name": "edit",
              "title": "src/middleware/rate-limit.ts"
            }
          }
        },
        {
          "after_ms": 1000,
          "emit": {
            "type": "runtime.tool.completed",
            "payload": { "tool_call_id": "call-5", "outcome": "succeeded" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.test_run.started",
            "payload": { "test_run_id": "tests-2", "label": "make test SUITE=sign-in" }
          }
        },
        {
          "after_ms": 2000,
          "emit": {
            "type": "runtime.test_run.completed",
            "payload": { "test_run_id": "tests-2", "outcome": "passed", "summary": "24 passed" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.agent_message",
            "payload": {
              "text": "Failed attempts now count per account and per address, and all 24 sign-in tests pass."
            }
          }
        },
        { "after_ms": 0, "emit": { "type": "runtime.turn.completed", "payload": {} } }
      ]
    },
    {
      "text": "Change the lockout test to expect limits per address only.",
      "steps": [
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.agent_message",
            "payload": {
              "text": "I will change the test to match limits per address. Failures from different addresses will not lock an account."
            }
          }
        },
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.tool.started",
            "payload": {
              "tool_call_id": "call-6",
              "tool_name": "edit",
              "title": "test/sign-in.test.ts"
            }
          }
        },
        {
          "after_ms": 800,
          "emit": {
            "type": "runtime.tool.completed",
            "payload": { "tool_call_id": "call-6", "outcome": "succeeded" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.test_run.started",
            "payload": { "test_run_id": "tests-3", "label": "make test SUITE=sign-in" }
          }
        },
        {
          "after_ms": 2000,
          "emit": {
            "type": "runtime.test_run.completed",
            "payload": { "test_run_id": "tests-3", "outcome": "passed", "summary": "24 passed" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.agent_message",
            "payload": {
              "text": "The lockout test now expects limits per address only, and all 24 sign-in tests pass."
            }
          }
        },
        { "after_ms": 0, "emit": { "type": "runtime.turn.completed", "payload": {} } }
      ]
    },
    {
      "text": "Keep failed attempts in memory until the migration is approved.",
      "steps": [
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.agent_message",
            "payload": {
              "text": "I will keep the counts in memory for now, per address and per account. They reset when the service restarts."
            }
          }
        },
        {
          "after_ms": 400,
          "emit": {
            "type": "runtime.tool.started",
            "payload": {
              "tool_call_id": "call-7",
              "tool_name": "edit",
              "title": "src/middleware/rate-limit.ts"
            }
          }
        },
        {
          "after_ms": 1100,
          "emit": {
            "type": "runtime.tool.completed",
            "payload": { "tool_call_id": "call-7", "outcome": "succeeded" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.test_run.started",
            "payload": { "test_run_id": "tests-4", "label": "make test SUITE=sign-in" }
          }
        },
        {
          "after_ms": 2000,
          "emit": {
            "type": "runtime.test_run.completed",
            "payload": { "test_run_id": "tests-4", "outcome": "passed", "summary": "24 passed" }
          }
        },
        {
          "after_ms": 0,
          "emit": {
            "type": "runtime.agent_message",
            "payload": {
              "text": "Failed attempts are counted in memory until the migration runs, and all 24 sign-in tests pass."
            }
          }
        },
        { "after_ms": 0, "emit": { "type": "runtime.turn.completed", "payload": {} } }
      ]
    }
  ]
