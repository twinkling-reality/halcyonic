{
  "format": 1,
  "id": "failing_tests",
  "description": "Edits code and ends its turn although its last test run failed, so the claim of completion is not verified.",
  "steps": [
    {
      "after_ms": 600,
      "emit": {
        "type": "runtime.agent_message",
        "payload": {
          "text": "The checkout tests are flaky because of a shared clock. I will inject the clock."
        }
      }
    },
    {
      "after_ms": 500,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-1",
          "tool_name": "edit",
          "title": "Edit src/checkout/clock.ts"
        }
      }
    },
    {
      "after_ms": 1500,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-1", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 300,
      "emit": {
        "type": "runtime.test_run.started",
        "payload": { "test_run_id": "tests-1", "label": "pnpm test checkout" }
      }
    },
    {
      "after_ms": 2800,
      "emit": {
        "type": "runtime.test_run.completed",
        "payload": {
          "test_run_id": "tests-1",
          "outcome": "failed",
          "summary": "3 failed, 39 passed"
        }
      }
    },
    {
      "after_ms": 500,
      "emit": {
        "type": "runtime.agent_message",
        "payload": {
          "text": "The clock is injected. Three checkout tests still fail and need a closer look."
        }
      }
    },
    { "after_ms": 200, "emit": { "type": "runtime.turn.completed", "payload": {} } }
  ]
}
