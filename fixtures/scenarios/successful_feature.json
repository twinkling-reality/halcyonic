{
  "format": 1,
  "id": "successful_feature",
  "description": "Implements a small feature: edits two files, runs the tests, which pass, and completes the turn.",
  "steps": [
    {
      "after_ms": 600,
      "emit": {
        "type": "runtime.agent_message",
        "payload": {
          "text": "I will add the reset token model and the request endpoint, then run the tests."
        }
      }
    },
    {
      "after_ms": 500,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-1",
          "tool_name": "edit",
          "title": "Edit src/auth/reset-token.ts"
        }
      }
    },
    {
      "after_ms": 1200,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-1", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 300,
      "emit": {
        "type": "runtime.tool.started",
        "payload": {
          "tool_call_id": "call-2",
          "tool_name": "edit",
          "title": "Edit src/routes/password-reset.ts"
        }
      }
    },
    {
      "after_ms": 1400,
      "emit": {
        "type": "runtime.tool.completed",
        "payload": { "tool_call_id": "call-2", "outcome": "succeeded" }
      }
    },
    {
      "after_ms": 300,
      "emit": {
        "type": "runtime.test_run.started",
        "payload": { "test_run_id": "tests-1", "label": "pnpm test" }
      }
    },
    {
      "after_ms": 2500,
      "emit": {
        "type": "runtime.test_run.completed",
        "payload": { "test_run_id": "tests-1", "outcome": "passed", "summary": "42 passed" }
      }
    },
    {
      "after_ms": 400,
      "emit": {
        "type": "runtime.agent_message",
        "payload": { "text": "The reset flow is implemented and the test suite passes." }
      }
    },
    { "after_ms": 200, "emit": { "type": "runtime.turn.completed", "payload": {} } }
  ]
}
