node_modules/
coverage/
*.tsbuildinfo
.DS_Store

# Local runtime state. The control plane defaults to ~/.halcyonic; these cover data
# directories pointed inside the repository during development.
/.data/
*.db
*.db-wal
*.db-shm

# Secrets and local environment overrides.
.env
.env.*

# Git worktrees that agent sessions create for isolated work.
/.claude/worktrees/

# Private working material: plans, research notes, handoffs and scratch output that are
# not canonical documentation. Durable conclusions belong in docs/internal instead.
/.private/
*.private.md

# Private documents: the roadmap, competition strategy, and records about private repositories.
# Local only, never pushed (see docs/internal/README.md).
/docs/private/

# .NET build output for the C# verification projects.
/apps/xr/dotnet/**/bin/
/apps/xr/dotnet/**/obj/
/apps/xr/dotnet/TestResults/

# Unity: generated and per-user folders, and the solution and project files the editor writes.
/apps/xr/[Ll]ibrary/
/apps/xr/[Tt]emp/
/apps/xr/[Oo]bj/
/apps/xr/[Ll]ogs/
/apps/xr/[Bb]uild/
/apps/xr/[Bb]uilds/
/apps/xr/[Uu]ser[Ss]ettings/
/apps/xr/[Mm]emoryCaptures/
/apps/xr/*.csproj
/apps/xr/*.sln
/apps/xr/*.slnx
/apps/xr/.vs/
/apps/xr/.idea/
# Meta's Immersive Debugger agent settings: written per machine, with its LAN address and a token.
/apps/xr/Assets/Resources/DevAgentSettings.asset
/apps/xr/Assets/Resources/DevAgentSettings.asset.meta
# Left by Android builds: the Android Gradle plugin's native build files; Meta's OVRBuildConfig,
# recreated empty with a new GUID in every editor session that builds; the StreamingAssets folder
# Meta's build step creates for RuntimeActionBindings.json and leaves empty (the project has no
# streaming assets of its own); and the Performance Testing package's run files, which a failed
# build leaves in Resources.
/apps/xr/.utmp/
/apps/xr/Assets/Resources/OVRBuildConfig.asset
/apps/xr/Assets/Resources/OVRBuildConfig.asset.meta
/apps/xr/Assets/StreamingAssets/
/apps/xr/Assets/StreamingAssets.meta
/apps/xr/Assets/Resources/PerformanceTestRun*.json
/apps/xr/Assets/Resources/PerformanceTestRun*.json.meta
