<!--
  Divider, Button, ButtonIcon, and ButtonLabel come from the bundled
  Horizon kit. RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<!--
  The card is the kit's dark glass, never a white page: it is part of the place (VRIFY, 2026-11-16). A plain container,
  not the Horizon Panel, whose own light material ignores the background colour and draws pale frosted glass.
  The stylesheet below takes no comments: UIKitML's parser refuses them.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 280px;
    background-color: rgba(2, 3, 8, 0.97);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .panel-content {
    align-items: flex-start;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 30px;
    text-align: left;
    font-size: 20px;
    font-weight: 700;
    line-height: 22px;
    letter-spacing: -0.5px;
    color: rgba(255, 255, 255, 0.92);
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .sub-heading {
    color: rgba(255, 255, 255, 0.82);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    width: 100%;
    margin-top: 10px;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }

  .laptop-help {
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 12px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<div id="card" class="panel-root">
  <div id="card-words" class="panel-content">
    <div id="card-title" class="heading">Untitled Game</div>
    <Divider></Divider>
    <div id="card-line" class="sub-heading"></div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <div id="laptop-help" class="sub-heading laptop-help" style="display: none">
    Put on your headset to play this in VR. On a laptop: click to play, drag to look around, WASD to move,
    Space and E for buttons.
  </div>
  <div id="help-again" class="sub-heading laptop-help" style="display: none">Press H to show this again</div>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</div>
